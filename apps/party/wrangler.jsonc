{
  // Room server: one Durable Object per table (AGENTS.md §2). Rooms live at /parties/room/<CODE>.
  "name": "french-tarot-party",
  "main": "src/server.ts",
  "compatibility_date": "2026-11-01",
  "durable_objects": {
    "bindings": [{ "name": "Room", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Web pages allowed to connect, comma-separated; `*` stands for part of a host label.
  // Set it to your Vercel addresses before deploying (docs/deploy.md). Local dev: .dev.vars.
  "vars": { "ALLOWED_ORIGINS": "" },
}
